# Warcon panel
WARCON_BASE_URL=http://warcon:3000
PANEL_PUBLIC_URL=https://panel.example.com
WARCON_TOKEN=

# Cloudflare Access service token — leave both empty on the VPS
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_MOD_ROLE_ID=

# Required: the servers to watch. Every alert is prefixed with its SERVER_LABELS label.
SERVER_IDS=0eec42dc-f73f-4e43-a62e-7e0900fcf38c,61dd0256-b780-40b5-a9fa-2b5bc542ce88,0abd34ac-c564-4d2e-9853-263d707528c3,33daa183-8c52-41f8-b936-b8524eaf7387,ff450efd-8080-4cab-a0ac-e5a3bf8fbf5f,c83bc8e1-ef6f-4d55-9398-b1a6f6faa2a8
SERVER_LABELS="0eec42dc-f73f-4e43-a62e-7e0900fcf38c=EU#1,61dd0256-b780-40b5-a9fa-2b5bc542ce88=EU#2,0abd34ac-c564-4d2e-9853-263d707528c3=NA#1,33daa183-8c52-41f8-b936-b8524eaf7387=NA#2,ff450efd-8080-4cab-a0ac-e5a3bf8fbf5f=OC#1,c83bc8e1-ef6f-4d55-9398-b1a6f6faa2a8=NA#3"

POLL_INTERVAL_MS=30000
KD_POLL_INTERVAL_MS=3600000
REQUEST_TIMEOUT_MS=10000
STATE_PATH=/data/state.json

# Only the live "hot right now" alert can mention the mod role. Unset, blank or `live`: it does.
# PING_ON=none posts everything without a ping.
PING_ON=live

# Hot right now: all three must hold, in the current match.
LIVE_PER_HOUR=20
LIVE_MIN_MINUTES=20
LIVE_MIN_KILLS=8

# Known players, refreshed every KD_POLL_INTERVAL_MS; their join tags post once per JOIN_ALERT_HOURS.
JOIN_ALERT_HOURS=24
SWEAT_PER_HOUR=15
SWEAT_RANGE=30d
RATE_MIN_MINUTES=180
KD_THRESHOLD=4.0
KD_MIN_MATCHES=5
KD_MIN_MINUTES=60
KD_RANGE=30d
FEED_QUIET_MINUTES=30

# /lookup: Steam playtime (all games, most played, Wardogs) and /id/ profile links.
# Optional; get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
WARDOGS_APP_ID=1867240
# Apps left out of the Steam total and top game. Unset: Crosshair X, HudSight, Lossless Scaling,
# Wallpaper Engine, OBS and similar tools. Set it to replace that list, or `none`.
# STEAM_IGNORE_APP_IDS=1366800,2641350,1477830,431960,993090,1905180,629520,966610,3301060

# Steam veteran join tag (needs STEAM_API_KEY): all-games hours (tools left out), or hours in one
# competitive game. 0 turns a line off. Unset STEAM_COMPETITIVE_APP_IDS: CS2, Siege, Rust, Dota 2,
# PUBG, Apex, Squad, Hell Let Loose, Hunt, Insurgency, Arma 3, Overwatch 2, Deadlock, THE FINALS,
# Marvel Rivals, Battlefield 2042.
STEAM_TOTAL_HOURS=10000
STEAM_GAME_HOURS=1000
# STEAM_COMPETITIVE_APP_IDS=730,359550,252490,570
